# ── Optional GitHub Access ────────────────────────────────────────────────────
# HiveCore does not need a GitHub token for today's control-plane flow.
# If you set one for future suite-level GitHub reads, Metadata (read) is enough.
# Suite-wide classic PAT used by PatchHive read paths.
# Recommended for public repositories: public_repo
# PATCHHIVE_GITHUB_TOKEN_RO=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HIVE_CORE_PR_RECONCILE_INTERVAL_SECONDS=300
# HIVE_CORE_FLEET_JOB_LEASE_SECONDS=300
# Canonical repository-owner opt-out feed. The sync key must match the registry.
# PATCHHIVE_OPT_OUT_FEED_URL=https://registry.patchhive.dev/v1/sync/repository-opt-outs
# PATCHHIVE_OPT_OUT_SYNC_KEY=
# HIVE_CORE_OPT_OUT_SYNC_INTERVAL_SECONDS=300

# ── Optional app auth ─────────────────────────────────────────────────────────
# HIVE_CORE_API_KEY_HASH=
# HIVE_CORE_SERVICE_TOKEN_HASH=

# ── Storage ───────────────────────────────────────────────────────────────────
HIVE_CORE_DB_PATH=hive-core.db
HIVE_CORE_PORT=8100
# Generate with: openssl rand -hex 32. This encrypts saved service tokens and,
# when no external suite bootstrap secret is configured, HiveCore's generated
# durable bootstrap authority. Keep it stable across restarts.
# HIVECORE_ENCRYPTION_KEY=
# Exact-dispatch approvals expire after 24 hours by default (1-168).
# HIVECORE_APPROVAL_TTL_HOURS=24
# HIVE_CORE_CONDUCTOR_INTERVAL_SECS=300
# HIVE_CORE_CONDUCTOR_LEASE_SECS=60
# HIVE_CORE_CONDUCTOR_MAX_MANDATES_PER_TICK=10
# PATCHHIVE_LAUNCHER_URL=http://localhost:8210
# Optional externally managed authority. Generate with: openssl rand -hex 32
# PATCHHIVE_SUITE_BOOTSTRAP_SECRET=

# HiveCore ships with built-in localhost defaults for every PatchHive product.
# Override product URLs per environment from the Settings tab after first boot.
# When patchhive-launcher is running, HiveCore's Setup tab can start the first
# stack and pair with already-running local products automatically.

# ── Logging ───────────────────────────────────────────────────────────────────
RUST_LOG=info
